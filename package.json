{
  "name": "antytilt-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/api.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "start:api": "tsx server/api.ts",
    "start:worker": "tsx server/worker.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:migrate:sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test:drawings": "node scripts/drawing-smoke-test.mjs 9223",
    "test:catalog": "node scripts/catalog-smoke-test.mjs 9223",
    "test:market-data": "tsx scripts/market-data-normalizers.test.ts",
    "test:market-data-live": "node scripts/market-data-smoke-test.mjs",
    "test:futures-api": "node scripts/futures-api-smoke-test.mjs",
    "test:bingx-client": "tsx server/bingxClient.test.ts",
    "test:exchange-api": "tsx server/exchangeApi.test.ts",
    "test:database": "tsx server/database.test.ts",
    "test:redis": "tsx server/redis.test.ts",
    "test:auth-ui": "node scripts/auth-ui-smoke-test.mjs",
    "test:risk-guard": "tsx server/riskGuard.test.ts",
    "test:risk-automation": "tsx server/riskAutomation.test.ts",
    "test:exchange-ui": "node scripts/exchange-ui-smoke-test.mjs",
    "test:exchange-connected-ui": "node scripts/exchange-connected-smoke-test.mjs",
    "test:risk-ui": "node scripts/risk-management-ui-smoke-test.mjs",
    "jupiter:ticket": "tsx scripts/jupiter-close-ticket.ts",
    "test:jupiter-ticket": "tsx --test server/jupiterCloseTicket/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@vitejs/plugin-react": "latest",
    "bs58": "6.0.0",
    "bullmq": "^6.3.11",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "json-bigint": "^1.0.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "latest",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/json-bigint": "^1.0.4",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5",
    "pg-mem": "^3.0.14",
    "puppeteer-core": "^25.9.0",
    "typescript": "latest",
    "vite": "latest"
  }
}
